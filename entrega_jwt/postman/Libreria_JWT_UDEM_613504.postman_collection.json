    {
      "name": "05 · Ataques contra el JWT (deben fallar)",
      "description": "El script de esta carpeta fabrica cuatro tokens maliciosos con CryptoJS, usando el secreto del ENTORNO ({{jwt_secret}}) — igual que en producción, donde la clave va en variables de entorno o en un secret manager y nunca en el código fuente. Los cuatro deben dar 401.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Cada script de Postman corre en su propio ámbito, así que las utilidades",
              "// de JWT se declaran aquí mismo (no se pueden heredar de otro script).",
              "",
              "// Base64URL sin relleno (=), como exige el RFC 7519.",
              "function b64url(str) {",
              "  return CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(str))",
              "    .replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
              "}",
              "function b64urlJson(obj) { return b64url(JSON.stringify(obj)); }",
              "",
              "// Firma HS256: HMAC-SHA256 sobre 'header.payload'.",
              "function firmar(header, payload, secreto) {",
              "  var datos = b64urlJson(header) + '.' + b64urlJson(payload);",
              "  var firma = CryptoJS.HmacSHA256(datos, secreto);",
              "  return datos + '.' + CryptoJS.enc.Base64.stringify(firma)",
              "    .replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
              "}",
              "",
              "var secreto = pm.environment.get('jwt_secret');",
              "var ahora = Math.floor(Date.now() / 1000);",
              "var base = { iss: 'library-login', aud: 'library-api', sub: '1', role: 'Usuario' };",
              "",
              "function conExtra(extra) {",
              "  var p = { iss: base.iss, aud: base.aud, sub: base.sub, role: base.role };",
              "  for (var k in extra) { p[k] = extra[k]; }",
              "  return p;",
              "}",
              "",
              "// 1) alg:none — el ataque clásico: token sin firma. Debe rechazarse SIEMPRE.",
              "var cabeceraNone = { alg: 'none', typ: 'JWT' };",
              "var payloadNone = conExtra({ iat: ahora, nbf: ahora, exp: ahora + 900 });",
              "pm.environment.set('jwt_none',",
              "  b64urlJson(cabeceraNone) + '.' + b64urlJson(payloadNone) + '.');",
              "",
              "// 2) Firma con OTRO secreto: el atacante firma bien, pero no con la clave del servidor.",
              "pm.environment.set('jwt_forged', firmar({ alg: 'HS256', typ: 'JWT' },",
              "  conExtra({ iat: ahora, nbf: ahora, exp: ahora + 900, role: 'Administrador' }),",
              "  'secreto-del-atacante'));",
              "",
              "// 3) Token EXPIRADO, firmado correctamente con el secreto real.",
              "pm.environment.set('jwt_expired', firmar({ alg: 'HS256', typ: 'JWT' },",
              "  conExtra({ iat: ahora - 3600, nbf: ahora - 3600, exp: ahora - 60 }), secreto));",
              "",
              "// 4) Token válido pero con OTRA audiencia (no es para este servicio).",
              "pm.environment.set('jwt_foreign_aud', firmar({ alg: 'HS256', typ: 'JWT' },",
              "  conExtra({ aud: 'otra-api', iat: ahora, nbf: ahora, exp: ahora + 900 }), secreto));"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "alg:none  (token sin firma) -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('El token con alg:none se rechaza: 401', function () { pm.response.to.have.status(401); });",
                  "var b = pm.response.json();",
                  "var codigo = (b.error && b.error.code) || b.code;",
                  "console.log('Código de rechazo: ' + codigo);",
                  "pm.test('Se identifica el ataque (ALGORITHM_NONE_REJECTED)', function () {",
                  "  pm.expect(codigo).to.eql('ALGORITHM_NONE_REJECTED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_none}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isbn\": \"ATAQUE-NONE-613504\",\n  \"title\": \"No debe entrar\",\n  \"price\": 1,\n  \"stock\": 1,\n  \"publication_year\": 2026,\n  \"format_id\": 7,\n  \"category_id\": 8,\n  \"author_ids\": [2],\n  \"genre_ids\": []\n}",
              "options": { "raw": { "language": "json" } }
