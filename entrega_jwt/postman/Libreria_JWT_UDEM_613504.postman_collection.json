    {
      "name": "04 · Sesión, introspección y refresh token",
      "description": "El access token es stateless (el servicio de libros no consulta la base). El refresh token es opaco, de un solo uso y rotativo: si se reutiliza uno ya rotado, se revocan todas las sesiones del usuario.",
      "item": [
        {
          "name": "GET /session  (con Bearer) -> valida el token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('El servicio de login acepta el JWT: 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Informa que la credencial usada es un JWT', function () {",
                  "  pm.expect(pm.response.json().data.session.credential).to.eql('jwt');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "url": { "raw": "{{base_url_login}}/session?format=json", "host": ["{{base_url_login}}"], "path": ["session"], "query": [{ "key": "format", "value": "json" }] }
          }
        },
        {
          "name": "POST /verify  (introspección stateless) -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('El token es válido', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.valid).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url_login}}/verify?format=json", "host": ["{{base_url_login}}"], "path": ["verify"], "query": [{ "key": "format", "value": "json" }] }
          }
        },
        {
          "name": "POST /refresh  (rota el refresh token) -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var cuerpo = pm.response.json();",
                  "var sesion = cuerpo.data.session;",
                  "pm.test('El refresh entrega un access_token nuevo', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(sesion.access_token).to.be.a('string');",
                  "});",
                  "pm.test('Y rota el refresh_token (el anterior queda quemado)', function () {",
                  "  pm.expect(sesion.refresh_token).to.not.eql(pm.environment.get('refresh_token'));",
                  "});",
                  "pm.environment.set('refresh_token_viejo', pm.environment.get('refresh_token'));",
                  "pm.environment.set('access_token', sesion.access_token);",
                  "pm.environment.set('refresh_token', sesion.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
