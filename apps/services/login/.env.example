# ==============================================================================
# Configuración del microservicio de autenticación (apps/services/login)
# Copia este archivo a .env y ajusta los valores reales.
# ==============================================================================

# --- Base de datos PostgreSQL (base existente del proyecto) ---
DB_USER=library_user
DB_PASSWORD=666
DB_NAME=library
DB_HOST=localhost
DB_PORT=5432

# --- Servidor ---
PORT=5000

# --- Seguridad ---
# Clave usada para firmar los desafíos CAPTCHA (HMAC). Cámbiala en producción.
SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria

# --- Sesión (sin cookies) ---
SESSION_MINUTES=30

# --- CAPTCHA sin GUI ---
CAPTCHA_TTL_SECONDS=300

# --- Protección contra fuerza bruta ---
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=60

# --- Hash de contraseñas ---
BCRYPT_ROUNDS=12

# ==============================================================================
# JWT (RFC 7519) — access token autocontenido + refresh token rotativo
# ==============================================================================
# IMPORTANTE: JWT_SECRET debe tener EXACTAMENTE el mismo valor en el
# microservicio de libros (apps/services/soap/.env). Con ese secreto compartido
# el servicio de libros verifica la firma SIN llamar a este servicio.
# Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_aleatorio_y_compartelo_con_books
JWT_ALGORITHM=HS256
JWT_ISSUER=library-login
JWT_AUDIENCE=library-api
# Vigencia del access token. El ejercicio guiado de Redis pide 20 minutos.
JWT_ACCESS_MINUTES=20
# Vigencia del refresh token (larga: se guarda hasheado y es revocable).
JWT_REFRESH_DAYS=7
# Tolerancia de reloj entre hosts al validar exp/nbf/iat.
JWT_LEEWAY_SECONDS=5
# Comprueba la revocación en user_sessions dentro de ESTE servicio.
# El servicio de libros no puede hacerlo (es sin estado por diseño).
JWT_CHECK_SESSION=true

# ==============================================================================
# Redis — capa compartida (sesiones, revocación de JWT y caché del catálogo)
# ==============================================================================
# Formato: redis://:<password>@<host>:6379/<db>
#   * usuario vacío y contraseña tras los dos puntos (es lo que pide el ejercicio)
#   * db 0 por omisión
# El host es el de la VM donde corre Redis (redis-cli ping debe responder PONG).
# Para que la contraseña tenga efecto, en /etc/redis/redis.conf:
#     requirepass <password>
#     bind 0.0.0.0            (solo si los microservicios están en otra máquina)
#     protected-mode no       (ídem; nunca exponer a Internet sin firewall)
REDIS_URL=redis://:cambia_esta_password@127.0.0.1:6379/0

# TTL del refresh token en Redis (coherente con JWT_REFRESH_DAYS=7).
REDIS_REFRESH_TTL=604800
# TTL corto del caché del catálogo (GET /books y GET /books/<isbn>).
REDIS_CACHE_TTL=30
# Tiempo máximo de espera de una operación de Redis (segundos).
REDIS_SOCKET_TIMEOUT=0.5
# Política de fallo. true  -> sesión/revocación/autenticación fallan CERRADO
#                            (503) si Redis no responde. Es lo que pide el
#                            enunciado. El caché SIEMPRE es opcional (fail-open).
REDIS_REQUIRED_FOR_AUTH=true
# Prefijo opcional de claves (útil si se comparte la instancia entre proyectos).
REDIS_KEY_PREFIX=

# Origenes permitidos por CORS (lista separada por comas; NUNCA "*")
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://34.51.29.27:3000
