    {
      "name": "10 - Session (con token)",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Session-Token", "value": "{{session_token}}" }],
        "url": { "raw": "{{base_url}}/session?format=json", "host": ["{{base_url}}"], "path": ["session"], "query": [{ "key": "format", "value": "json" }] },
        "description": "La sesión viaja en el header X-Session-Token, NO en una cookie."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('authenticated = true', () => pm.expect(body.data.authenticated).to.eql(true));",
              "pm.test('Devuelve el usuario', () => pm.expect(body.data.user).to.have.property('email'));",
              "pm.test('Quedan menos de 30 minutos de sesión', () => pm.expect(body.data.session.remaining_seconds).to.be.below(1801));",
              "pm.test('No se creó ninguna cookie', () => pm.expect(pm.response.headers.has('Set-Cookie')).to.eql(false));"
            ]
          }
        }
      ]
    },
