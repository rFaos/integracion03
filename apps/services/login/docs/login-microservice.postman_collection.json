          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Devuelve el token de sesión', () => pm.expect(body.data.session.token).to.be.a('string'));",
              "pm.test('La sesión dura 30 minutos', () => pm.expect(body.data.session.expires_in).to.eql(1800));",
              "pm.test('Indica el header a usar', () => pm.expect(body.data.session.header).to.eql('X-Session-Token'));",
