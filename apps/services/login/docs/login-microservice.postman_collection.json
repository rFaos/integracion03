{
  "info": {
    "name": "INTEGRACION03 - Login Microservice",
    "description": "Colección de verificación del microservicio de autenticación y gestión de usuarios.\n\nFormato predeterminado: XML. Para JSON agrega ?format=json.\nPostman envía 'Accept: */*' por defecto, por lo que SIN ?format=json la respuesta llega en XML y debe parsearse con xml2Json().\n\nOrden recomendado: ejecutar con el Collection Runner de arriba hacia abajo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://34.51.29.27:5000" },
    { "key": "user_email", "value": "" },
    { "key": "user_password", "value": "S3gura!2026" },
    { "key": "seed_email", "value": "usuario1@library.local" },
    { "key": "seed_password", "value": "666" },
    { "key": "captcha_id", "value": "" },
    { "key": "captcha_answer", "value": "" },
    { "key": "session_token", "value": "" },
    { "key": "user_id", "value": "" }
  ],
  "item": [
    {
      "name": "00 - API Root (HATEOAS)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/?format=json", "host": ["{{base_url}}"], "path": [""], "query": [{ "key": "format", "value": "json" }] },
        "description": "Punto de entrada HATEOAS: publica todos los recursos disponibles (Nivel 3 de Richardson)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const links = pm.response.json()._links;",
              "pm.test('Expone los 7 enlaces del API (HATEOAS)', () => {",
              "    ['register','login','logout','session','health','captcha','docs'].forEach(r =>",
              "        pm.expect(links).to.have.property(r));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "01 - Health (XML por defecto)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] },
        "description": "Sin ?format se responde XML (formato predeterminado del enunciado)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type es application/xml', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/xml'));",
              "const xml = xml2Json(pm.response.text());",
              "pm.test('status = success', () => pm.expect(xml.response.status).to.eql('success'));",
              "pm.test('PostgreSQL conectado', () => pm.expect(xml.response.data.database).to.eql('connected'));",
              "pm.test('Incluye bloque <links>', () => pm.expect(xml.response).to.have.property('links'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Health (JSON)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/health?format=json", "host": ["{{base_url}}"], "path": ["health"], "query": [{ "key": "format", "value": "json" }] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Responde JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const body = pm.response.json();",
              "pm.test('status = success', () => pm.expect(body.status).to.eql('success'));",
              "pm.test('Incluye _links', () => pm.expect(body._links).to.have.property('self'));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Captcha (nuevo desafío)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/captcha?format=json", "host": ["{{base_url}}"], "path": ["captcha"], "query": [{ "key": "format", "value": "json" }] },
        "description": "Resuelve el desafío y lo guarda en variables. El CAPTCHA es de un solo uso, así que debe pedirse uno nuevo antes de cada registro/login."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test('Devuelve captcha_id', () => pm.expect(data).to.have.property('captcha_id'));",
              "pm.test('La pregunta es aritmética', () => pm.expect(data.question).to.match(/\\d+\\s*[+\\-]\\s*\\d+/));",
              "// Se resuelve y se guarda para el siguiente request de autenticación",
              "pm.collectionVariables.set('captcha_id', data.captcha_id);",
              "const expr = data.question.match(/\\d+\\s*[+\\-]\\s*\\d+/)[0];",
              "pm.collectionVariables.set('captcha_answer', String(eval(expr)));",
              "console.log('CAPTCHA resuelto:', expr, '=', pm.collectionVariables.get('captcha_answer'));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Register (JSON)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Fabián\",\n  \"apellido_paterno\": \"Azaed\",\n  \"apellido_materno\": \"Orta\",\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\",\n  \"captcha_id\": \"{{captcha_id}}\",\n  \"captcha_answer\": \"{{captcha_answer}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/register?format=json", "host": ["{{base_url}}"], "path": ["register"], "query": [{ "key": "format", "value": "json" }] }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Correo único por corrida para que el registro no choque con un 409",
              "pm.collectionVariables.set('user_email', 'usuario.' + Date.now() + '@library.local');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.test('Devuelve encabezado Location', () => pm.response.to.have.header('Location'));",
              "const body = pm.response.json();",
              "pm.test('status = success', () => pm.expect(body.status).to.eql('success'));",
              "pm.test('No expone el hash de la contraseña', () => pm.expect(JSON.stringify(body)).to.not.include('password_hash'));",
              "pm.collectionVariables.set('user_id', body.data.user.id);",
              "console.log('Usuario registrado:', body.data.user.email, '| id =', body.data.user.id);"
            ]
          }
        }
      ]
    },
