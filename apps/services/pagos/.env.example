# ==============================================================================
# Configuración del microservicio de usuarios (apps/services/users)
# Copia este archivo a .env y ajusta los valores reales.
# ==============================================================================

# --- Base de datos PostgreSQL (la misma base `library` del proyecto) ---
DB_USER=library_user
DB_PASSWORD=666
DB_NAME=library
DB_HOST=localhost
DB_PORT=5432

# --- Servidor ---
# login 5000 | libros 5001 | users 5002 | autores 5003 | pedidos 5004 | pagos 5005
PORT=5005
FLASK_DEBUG=False

# ==============================================================================
# JWT (RFC 7519) — SOLO verificación: este servicio nunca emite tokens
# ==============================================================================
# JWT_SECRET debe ser EXACTAMENTE el mismo que en TODOS los demás servicios.
# Es el único dato realmente compartido: con él se verifica la firma HMAC-SHA256
# sin consultar la base de sesiones ni llamar al servicio de login.
JWT_SECRET=cambia_esto_por_el_mismo_secreto_que_el_servicio_login
JWT_ALGORITHM=HS256
JWT_ISSUER=library-login
JWT_AUDIENCE=library-api
JWT_LEEWAY_SECONDS=5

# Id del catálogo `roles` que se considera administrador.
# Se usa el ID y no el texto para que renombrar el rol no rompa la autorización.
ADMIN_ROLE_ID=1

# Dirección pública del servicio de login (solo para los enlaces de hipermedia).
LOGIN_BASE_URL=http://localhost:5000

# ==============================================================================
# CORS — solo los orígenes de las aplicaciones cliente (NUNCA "*")
# ==============================================================================
# Separados por coma. El cliente de escritorio Tk no envía Origin, así que CORS
# no le afecta; esto protege a los clientes de navegador (monolito y Electron).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://34.51.29.27:3000

# ==============================================================================
# Redis — capa compartida (revocación de JWT)
# ==============================================================================
# MISMA URL que en el resto de microservicios. Formato:
#   redis://:<password>@<host>:6379/<db>
REDIS_URL=redis://:cambia_esta_password@127.0.0.1:6379/0
REDIS_SOCKET_TIMEOUT=0.5
# true -> si no se puede comprobar la revocación, la petición se rechaza (503).
# Es la política que exige el enunciado para sesión, revocación y autorización.
REDIS_REQUIRED_FOR_AUTH=true
REDIS_KEY_PREFIX=
