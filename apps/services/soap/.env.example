# ==============================================================================
# Configuración del microservicio de libros (apps/services/soap)
# Copia este archivo a .env y ajusta los valores reales.
# ==============================================================================

# --- Base de datos PostgreSQL (base existente del proyecto) ---
DB_USER=library_user
DB_PASSWORD=666
DB_NAME=library
DB_HOST=localhost
DB_PORT=5432

# --- Servidor ---
# El servicio de autenticación usa el 5000; este usa el 5001 para no chocar.
PORT=5001
FLASK_DEBUG=True

# ==============================================================================
# JWT (RFC 7519) — autorización de las operaciones de escritura
# ==============================================================================
# IMPORTANTE: JWT_SECRET debe ser EXACTAMENTE el mismo que en
# apps/services/login/.env. Es el único dato compartido: con él se verifica la
# firma HMAC-SHA256 sin consultar la base de sesiones ni llamar al servicio login.
JWT_SECRET=cambia_esto_por_el_mismo_secreto_que_el_servicio_login
JWT_ALGORITHM=HS256
JWT_ISSUER=library-login
JWT_AUDIENCE=library-api
# Tolerancia de reloj entre hosts al validar exp/nbf/iat.
JWT_LEEWAY_SECONDS=5

# Dirección pública del servicio de autenticación. Solo se usa para construir
# los enlaces de hipermedia que acompañan a un 401.
LOGIN_BASE_URL=http://localhost:5000

# Rutas de ESCRITURA que se quieran dejar abiertas (path exacto, separadas por
# coma). Por defecto VACÍO: todo lo que modifica el catálogo exige token.
# Ejemplo: PUBLIC_UNSAFE_PATHS=/soap
PUBLIC_UNSAFE_PATHS=

# ==============================================================================
# Redis — capa compartida (revocación de JWT y caché del catálogo)
# ==============================================================================
# MISMA URL que en el resto de microservicios (login, users, autores, pedidos,
# pagos). Formato: redis://:<password>@<host>:6379/<db>
REDIS_URL=redis://:cambia_esta_password@127.0.0.1:6379/0

# TTL corto del caché: GET /books (books:list:<filtros>) y
# GET /books/<isbn> (books:<isbn>). Se invalida en cada POST/PUT/PATCH/DELETE.
REDIS_CACHE_TTL=30
REDIS_SOCKET_TIMEOUT=0.5
# true -> las ESCRITURAS fallan CERRADO (503) si no se puede comprobar la
# revocación del token. El caché de lecturas SIEMPRE es opcional (fail-open).
REDIS_REQUIRED_FOR_AUTH=true
REDIS_KEY_PREFIX=

# Origenes permitidos por CORS (lista separada por comas; NUNCA "*")
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://34.51.29.27:3000
